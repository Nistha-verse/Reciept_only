# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC_URL=https://example.invalid
# Throwaway testnet key: replace with 0x followed by 64 hexadecimal characters.
# Enter secrets only in .env, never in this template or shell commands.
DEPLOYER_PRIVATE_KEY=replace-me
# Optional Basescan source verification credential
BASESCAN_API_KEY=
# Development bridge must bind to this address and must not run in production.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
